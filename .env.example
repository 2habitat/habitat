# 空间根（Markdown 文件所在目录）。不设则用 ./space
# HABITAT_SPACE=/绝对路径/你的空间

# 服务
HABITAT_PORT=8787
HABITAT_HOST=127.0.0.1
# 访问令牌：留空则关闭鉴权（只建议在纯本机使用时这么做）
KB_TOKEN=
# 认证 Cookie 名（从旧系统迁移时保持同名，会话不用重登）
HABITAT_COOKIE=kb_token

# 邮件通知（可选）。也可用 ~/.habitat/mail.json
# HABITAT_SMTP_HOST=smtp.example.com
# HABITAT_SMTP_PORT=465
# HABITAT_SMTP_SECURE=1
# HABITAT_SMTP_USER=you@example.com
# HABITAT_SMTP_PASS=授权码或应用专用密码
# HABITAT_MAIL_TO=you@example.com

# 行为调参（都可不设）
# HABITAT_REMIND_WINDOW_MIN=30      日程提前多少分钟提醒
# HABITAT_BRIEF_HOUR=8              每日简报几点后发
# HABITAT_ARCHIVE_DONE_DAYS=30      已完成任务多久自动归档
# HABITAT_MAX_UPLOAD_MB=64          单文件上传上限
