# 空间根（Markdown 文件所在目录）。不设则用 ./space
# HABITAT_SPACE=/绝对路径/你的空间

# 服务
HABITAT_PORT=8787
HABITAT_HOST=127.0.0.1

# ---------- 鉴权 ----------
# auto（默认）：账号文件里有用户就启用用户名密码登录
# on：即使没有账号也启用，并在首次启动时创建管理员（临时密码打印在日志里）
# off：只用访问令牌（没有令牌时等于不鉴权，仅限本机开发）
HABITAT_AUTH=auto
# 账号文件：密码哈希与登录会话密钥。默认 ~/.habitat/auth.json，故意不放在空间目录（空间常被同步到云盘）
# HABITAT_AUTH_FILE=/绝对路径/auth.json
# 密码有效期（天）。到期后登录会被强制改密；0 = 永不过期
HABITAT_PASSWORD_DAYS=90
# 首次以 HABITAT_AUTH=on 启动时创建的管理员
# HABITAT_ADMIN_USER=admin
# HABITAT_ADMIN_PASSWORD=
# 初始密码是否强制首次登录修改（默认 1；设 0 表示不强制）
# HABITAT_ADMIN_FORCE_CHANGE=1

# 访问令牌：给脚本 / Agent 用。留空则不启用令牌；用户名密码登录不受它影响
KB_TOKEN=
# 令牌 Cookie 名（从旧系统迁移时保持同名，脚本不用改）
HABITAT_COOKIE=kb_token
# 人的会话 Cookie 名
HABITAT_SESSION_COOKIE=kb_session

# 邮件通知（可选）。也可用 ~/.habitat/mail.json
# HABITAT_SMTP_HOST=smtp.example.com
# HABITAT_SMTP_PORT=465
# HABITAT_SMTP_SECURE=1
# HABITAT_SMTP_USER=you@example.com
# HABITAT_SMTP_PASS=授权码或应用专用密码
# HABITAT_MAIL_TO=you@example.com

# ---------- Agent 会话 / 平台闭环 ----------
# 远端 harness 拿到的 MCP 回连地址；对外部署时必须设成公网地址，否则远端拿到的
# 是 127.0.0.1，工具面连不上
# HABITAT_PUBLIC_URL=https://habitat.example.com
# 平台自动驾驶：每隔多久挑一条「该跑但没跑」的判断类闭环交给 harness（0=关闭）
# 打开前先配好 agents.yaml，并确认模型调用成本可控
HABITAT_AGENT_LOOP_MS=0
# 每轮最多跑几条（默认 1），以及用哪个 harness（空=默认 harness）
HABITAT_AGENT_LOOP_LIMIT=1
# HABITAT_AGENT_HARNESS=dsh

# 行为调参（都可不设）
# HABITAT_REMIND_WINDOW_MIN=30      日程提前多少分钟提醒
# HABITAT_BRIEF_HOUR=8              每日简报几点后发
# HABITAT_ARCHIVE_DONE_DAYS=30      已完成任务多久自动归档
# HABITAT_MAX_UPLOAD_MB=64          单文件上传上限
